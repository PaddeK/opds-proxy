{
    "name": "opds-proxy",
    "version": "0.2.0",
    "private": true,
    "license": "MIT",
    "repository": "github:PaddeK/opds-proxy",
    "type": "module",
    "scripts": {
        "start": "bun src/index.ts",
        "dev": "DATA_DIR=./data bun --watch src/index.ts",
        "build": "bun build src/index.ts --compile --minify --sourcemap --outfile dist/opds-proxy",
        "test": "bun test",
        "typecheck": "tsc --noEmit",
        "crawl": "bun scripts/crawl.ts"
    },
    "devDependencies": {
        "@types/bun": "^1.4.3",
        "typescript": "^7.0.2"
    }
}
